# Discord
DISCORD_TOKEN=
# Optional: register slash commands to a single guild (instant). Global registration otherwise (can take up to 1h).
DISCORD_GUILD_ID=

# OpenAI
OPENAI_API_KEY=
# GPT-Live voice model (Live API)
LIVE_MODEL=gpt-live-1
# Voice: marin (default), quartz, ripple, vesper, willow, stone, gleam, meridian, bossa, tempo, beacon, delta, cinder
LIVE_VOICE=marin
# Backend model used by Responses delegation when GPT-Live needs deeper reasoning. Leave empty for client delegation (no backend).
LIVE_DELEGATION_MODEL=gpt-5.5

# Logging: debug | info
LOG_LEVEL=info
# Debug: dump raw session audio (24k mono WAV, in + out) into this directory. Leave empty to disable.
DUMP_AUDIO_DIR=
